# ---------------------------------------------------------------------------
# Pulsy environment configuration. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Database (Postgres) ---
# In docker compose, host is the `postgres` service name.
DATABASE_URL=postgres://pulsy:replace-with-database-password@postgres:5432/pulsy
# Compose Postgres settings. POSTGRES_PASSWORD is REQUIRED (compose refuses to
# start without it) — pick something strong and change DATABASE_URL to match.
# Postgres is only reachable from localhost (127.0.0.1) on the host.
POSTGRES_USER=pulsy
POSTGRES_PASSWORD=
POSTGRES_DB=pulsy
# Startup schema mode. Keep `migrate`; `push` is a temporary compatibility
# escape hatch only for databases created by early pre-migration releases.
PULSY_SCHEMA_MODE=migrate

# --- Security ---
# 32-byte key, base64 or hex. Encrypts email-provider credentials, notification targets,
# and custom notification-header values with AES-256-GCM.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-32-byte-base64-key
# better-auth signing secret. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-random-secret
# Optional comma-separated list of additional trusted web origins for CORS and
# better-auth. Leave empty for the default PUBLIC_WEB_URL/local loopback origins.
TRUSTED_ORIGINS=
# ⚠️  Outbound monitoring can access your private/LAN network by default.
# Keep this true for internal targets. Set false if accounts should only reach
# public destinations. DNS answers are pinned at connect and every redirect is
# rechecked. Metadata and link-local addresses remain blocked in every mode.
MONITOR_ALLOW_PRIVATE_NETWORKS=true
# Deprecated alias, used only when MONITOR_ALLOW_PRIVATE_NETWORKS is absent:
# BLOCK_PRIVATE_TARGETS=true means deny private targets; startup logs a warning.
# Trust the shipped nginx hop; use 2 with an additional trusted reverse proxy.
TRUST_PROXY_HOPS=1

# Per-IP request ceiling for /api/trpc (includes the public status-page and
# share-link procedures). Default 300/min per client IP.
TRPC_RATE_LIMIT_PER_MIN=

# Per-IP request ceiling for /api/auth/* (sign-in/sign-up/forgot-password).
# Default 10/min per client IP.
AUTH_RATE_LIMIT_PER_MIN=

# Refuse new account registrations (shared/demo instances). Existing accounts
# keep working. Default: signups open.
DISABLE_SIGNUP=false
# Free-text notice rendered on the login page (baked into the web build).
# Useful for demo instances, e.g. "Demo — demo@pulsy.org / …, resets nightly".
VITE_DEMO_NOTICE=

# --- Superadmin (optional; /superadmin operator panel) ---
# When both email and password are set, the server seeds (idempotently, in the
# background) a platform superadmin on startup and promotes it to role
# "superadmin". Leave blank to boot with no admin account. The password is read
# from env and never logged.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# Optional display name (defaults to "Superadmin").
SUPERADMIN_NAME=

# --- URLs ---
# Optional target for Vite's development proxy. The supported Compose runtime
# uses nginx's same-origin proxy instead.
PUBLIC_SERVER_URL=http://localhost:4000
# Public URL of the web app (used by better-auth for cookies/redirects).
PUBLIC_WEB_URL=http://localhost:3000
# better-auth browser-facing base URL. In Docker this matches PUBLIC_WEB_URL
# because nginx proxies /api/auth/* to the server container.
BETTER_AUTH_URL=http://localhost:3000
# Optional browser-visible server URL for non-proxied builds. Leave empty for
# same-origin `/api/*` via the web container/nginx proxy.
VITE_SERVER_URL=
# The app's own public URL (e.g. https://status.example.com). Baked into the web
# bundle at build time: any OTHER host the browser is on is treated as a custom
# status-page domain. REQUIRED for custom domains to render their page.
VITE_APP_URL=http://localhost:3000
# Public source tree linked from every app route. This value is baked into the
# web image. Forks and modified deployments should use the publicly reachable
# tag or commit containing the exact source used to build their deployed image.
VITE_SOURCE_CODE_URL=https://github.com/SelmiAbderrahim/pulsy

# --- Custom status-page domains ---
# Routing target advertised to users when they attach a custom domain to a
# status page. Users point their hostname here (CNAME preferred; A as fallback)
# so the host-side nginx + certbot daemon (ops/custom-domains) can serve the
# page and auto-issue TLS. Leave both empty if you wire nginx by hand.
#   CUSTOM_DOMAIN_CNAME_TARGET — stable hostname an A record points at this box.
#   CUSTOM_DOMAIN_IP           — this server's public IP (used if no CNAME set).
CUSTOM_DOMAIN_CNAME_TARGET=
CUSTOM_DOMAIN_IP=
# Comma-separated recursive resolvers used for status-page DNS verification.
# Override only when the defaults are unavailable from your deployment.
DNS_RESOLVERS=1.1.1.1,8.8.8.8
# Email the provisioning daemon registers with Let's Encrypt (certbot).
CERTBOT_EMAIL=
# Set truthy (1/true) to use the Let's Encrypt STAGING CA while testing — avoids
# rate limits; issued certs are not browser-trusted. Leave empty for production.
CERTBOT_STAGING=
# Webroot the per-domain :80 vhost serves the ACME http-01 challenge from.
# Optional; defaults to /var/www/pulsy-acme (created by the installer).
ACME_WEBROOT=
# The host provisioner normally reaches PostgreSQL through the Compose
# container because DATABASE_URL uses the Docker-only `postgres` hostname.
USE_DOCKER_PSQL=1
DB_CONTAINER=pulsy-postgres
# Optional overrides; blank values are derived from DATABASE_URL/defaults.
DB_USER=
DB_NAME=

# --- Ports ---
WEB_PORT=3000
SERVER_PORT=4000
POSTGRES_PORT=5432

# --- Email (optional; auth verification + monitor notifications) ---
# If unset, the server logs emails instead of sending (dev-friendly).
# Auth emails (verification + password reset) are sent via Resend.
RESEND_API_KEY=
EMAIL_FROM=Pulsy <noreply@pulsy.org>

# --- Email verification ---
# Require users to confirm their email after registering. When true, a
# verification email is sent on signup. Verification never limits monitor
# creation or hides features in this self-hosted app.
REQUIRE_EMAIL_VERIFICATION=true

# --- Retention ---
# Retains check logs, server-health metrics and reliability history in days.
CHECK_LOG_RETENTION_DAYS=30
# Rows deleted per batch by the daily cleanup job (keeps deletes lock-friendly).
CLEANUP_BATCH_SIZE=5000

# --- Scale tuning ---
# Postgres connection pool size for the server process (scheduler + API + auth
# all share this pool). Raise for large monitor counts.
DATABASE_POOL_MAX=20
# Max monitor checks allowed to run concurrently. Caps the thundering herd when
# many monitors fire on the same interval boundary.
CHECK_CONCURRENCY=20

# Notification retry delays in milliseconds (initial send + one attempt per
# delay). Keep the defaults unless you intentionally tune delivery behavior.
NOTIFICATION_RETRY_DELAYS_MS=30000,120000,600000

# --- Public REST API (/api/v1) ---
# First-party REST API authenticated with Bearer API keys (created/revoked in
# the dashboard). Docker-only dev: exercise it against the `pulsy-server`
# container. See docs/api/README.md.
# Master switch for the /api/v1 surface. Set to `false` to disable it entirely
# (the tRPC dashboard API and key management are unaffected).
API_V1_ENABLED=true
# Per-key fixed-window rate limit (requests per minute). In-memory and
# per-replica; Pulsy runs a single server process so this is exact.
API_RATE_LIMIT_PER_MIN=60
