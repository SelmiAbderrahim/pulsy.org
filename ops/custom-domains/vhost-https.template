# ============================================
# Pulsy custom domain (HTTPS) — ${DOMAIN}
# ============================================
# AUTO-GENERATED by provision-daemon.sh — appended to the HTTP block ONLY once
# /etc/letsencrypt/live/${DOMAIN}/ exists. The daemon owns the whole vhost; certbot
# issues the cert (certonly --webroot) but never edits this file.
#
# envsubst '${DOMAIN}' — nginx's own $host, $remote_addr, $connection_upgrade, etc.
# are left intact. Upstreams + rate-limit zones come from the pulsy.example.com vhost
# (or conf.d/pulsy-shared.conf on a fresh host).

server {
    listen 443 ssl;
    server_name ${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 10M;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    # better-auth — stricter rate limit; prefix preserved upstream.
    location ~ ^/api/auth {
        limit_req zone=pulsy_auth_limit burst=10 nodelay;
        proxy_pass http://pulsy_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 120s;
    }

    # tRPC API (public.statusPageByDomain resolves the page by Host).
    location /api/ {
        limit_req zone=pulsy_api_limit burst=50 nodelay;
        proxy_pass http://pulsy_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 120s;
    }

    location = /health {
        proxy_pass http://pulsy_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        access_log off;
    }

    # SPA — the bundle detects the custom Host and renders the status page.
    location / {
        proxy_pass http://pulsy_web;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    location ~ /\. { deny all; access_log off; log_not_found off; }
}
