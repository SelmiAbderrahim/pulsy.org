# ============================================
# Pulsy custom domain (HTTP) — ${DOMAIN}
# ============================================
# AUTO-GENERATED by provision-daemon.sh — do not edit (overwritten each reconcile).
# Always present. Serves the ACME http-01 challenge from the shared webroot so
# certbot (issuance AND renewal) never needs to touch nginx config, and redirects
# everything else to HTTPS. The daemon appends the matching vhost-https block once
# the certificate exists.
#
# envsubst '${DOMAIN} ${ACME_WEBROOT}' — nginx's own $host/$request_uri are kept.

server {
    listen 80;
    server_name ${DOMAIN};

    # Let's Encrypt webroot challenge (takes precedence over the redirect).
    location ^~ /.well-known/acme-challenge/ {
        root ${ACME_WEBROOT};
        default_type "text/plain";
        access_log off;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
