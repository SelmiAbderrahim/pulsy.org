{
  "name": "pulsy",
  "version": "0.1.0",
  "private": true,
  "description": "Pulsy — a self-hosted, open-source website uptime & downtime monitor.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SelmiAbderrahim/pulsy.git"
  },
  "homepage": "https://github.com/SelmiAbderrahim/pulsy#readme",
  "bugs": {
    "url": "https://github.com/SelmiAbderrahim/pulsy/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @pulsy/server typecheck && pnpm --filter @pulsy/db typecheck",
    "lint": "pnpm --filter @pulsy/server lint && pnpm --filter @pulsy/db typecheck",
    "test": "pnpm --filter @pulsy/server test && pnpm --filter @pulsy/db test",
    "db:generate": "pnpm --filter @pulsy/db generate",
    "db:migrate": "pnpm --filter @pulsy/db migrate",
    "db:seed": "pnpm --filter @pulsy/server seed"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
